{
  "name": "haste-inspector",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:wasm && tsc && vite build",
    "build:wasm": "wasm-pack build wasm --target web --out-dir ../src/generated/wasm --out-name haste_inspector_wasm --release",
    "check": "npm run build:wasm && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.0.18",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@tanstack/react-virtual": "^3.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "jotai": "^2.6.3",
    "lucide-react": "^0.319.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-resizable-panels": "^2.1.3",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "postcss": "^8.4.33",
    "prettier": "^3.8.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.61.1",
    "vite": "^5.4.6"
  }
}
